            "name": "province_code",
            "type": "string",
            "description": "Parent province",
            "constraints": {
              "required": true,
              "pattern": "\\d{2}"
            }
          },
          {
            "name": "postal_codes",
            "type": "string",
            "description": "Thailand Post codes. More than one when the subdistrict spans post office zones. Codes are separated by a space",
            "constraints": {
              "required": true,
