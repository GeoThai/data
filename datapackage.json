    {
      "name": "abolished-csv",
      "path": "csv/abolished.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "code",
            "type": "string",
            "description": "DOPA code",
            "constraints": {
              "required": true,
              "pattern": "\\d{2}|\\d{4}|\\d{6}"
            }
          },
          {
            "name": "name_th",
            "type": "string",
            "description": "Thai name",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "name_en",
            "type": "string",
            "description": "English name. Null in JSON and empty in CSV when DOPA gives none"
          },
          {
            "name": "level",
            "type": "string",
            "description": "Area level",
            "constraints": {
              "required": true,
              "enum": [
                "province",
                "district",
                "subdistrict"
              ]
            }
          },
          {
            "name": "parent_code",
            "type": "string",
            "description": "Parent area. Null in JSON and empty in CSV for a province"
          },
          {
            "name": "abolished_on",
            "type": "date",
            "description": "Date the area was abolished",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "successors",
            "type": "string",
            "description": "Areas that took its place. Empty when GeoThai has no notice for the change and no clear name match. Codes are separated by a space",
            "constraints": {
              "pattern": "(\\d{2}|\\d{4}|\\d{6})( (\\d{2}|\\d{4}|\\d{6}))*"
            }
          },
          {
            "name": "successors_basis",
            "type": "string",
            "description": "notice: from a reviewed notice, see successors_source. name: the one active subdistrict with the same Thai name in the province, for codes DOPA dropped in its 2006 cleanup; likely but not proven",
            "constraints": {
              "enum": [
                "notice",
                "name"
              ]
            }
          },
          {
            "name": "successors_in_force",
            "type": "date",
            "description": "Date the change took legal effect. DOPA often updates its list later, so it can be earlier than abolished_on"
          },
          {
            "name": "successors_source",
            "type": "string",
            "description": "The notice that made the change: title, Royal Gazette volume, part, page and URL"
          }
        ],
        "primaryKey": [
          "code"
        ]
      }
    },
