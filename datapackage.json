    }
  ],
  "sources": [
    {
      "title": "dopa-ccaatt",
      "path": "https://stat.bora.dopa.go.th/dload/ccaatt.xlsx",
      "version": "2023-09-01"
    },
    {
      "title": "thailand-geography-json",
      "path": "https://raw.githubusercontent.com/thailand-geography-data/thailand-geography-json/b8b3fb91c7df1129ff5b43cb46f7fcffadd2156b/src/subdistricts.json"
    },
    {
      "title": "thailandpost-postcode-2558",
      "path": "https://file.thailandpost.com/upload/content/2558_56a9d444d5276.pdf",
      "version": "2015-09-01"
    }
  ],
  "counts": {
    "provinces": 77,
    "districts": 928,
    "subdistricts": 7436,
    "abolished": 1583
  },
  "resources": [
    {
      "name": "provinces-csv",
      "path": "csv/provinces.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "code",
            "type": "string",
            "description": "DOPA province code",
            "constraints": {
              "required": true,
              "pattern": "\\d{2}"
            }
          },
          {
            "name": "name_th",
            "type": "string",
            "description": "Thai name",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "name_en",
            "type": "string",
            "description": "English name",
            "constraints": {
              "required": true
            }
          }
        ],
        "primaryKey": [
          "code"
        ]
      }
    },
