{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeoThai Metadata v1",
  "description": "Schema for GeoThai Metadata v1 data",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "The version of the data"
    },
    "last_updated": {
      "type": "string",
      "description": "The last updated date of the data"
    },
    "source": {
      "type": "string",
      "description": "The source of the data"
    },
    "total_provinces": {
      "type": "number",
      "description": "The total number of provinces"
    },
    "total_districts": {
      "type": "number",
      "description": "The total number of districts"
    },
    "total_subdistricts": {
      "type": "number",
      "description": "The total number of subdistricts"
    }
  },
  "required": [
    "version",
    "last_updated",
    "source",
    "total_provinces",
    "total_districts",
    "total_subdistricts"
  ]
}
