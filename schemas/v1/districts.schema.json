{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thailand Districts",
  "description": "Schema for Thailand Districts data",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "number",
        "description": "The index of the district"
      },
      "province_id": {
        "type": "number",
        "description": "The province id"
      },
      "district_id": {
        "type": "number",
        "description": "The district id"
      },
      "district_name_en": {
        "type": "string",
        "description": "The district name in english"
      },
      "district_name_th": {
        "type": "string",
        "description": "The district name in thai"
      },
      "postal_code": {
        "type": "number",
        "description": "The postal code"
      }
    },
    "required": [
      "id",
      "province_id",
      "district_id",
      "district_name_en",
      "district_name_th",
      "postal_code"
    ]
  }
}
