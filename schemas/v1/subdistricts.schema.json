{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thailand Subdistricts",
  "description": "Schema for Thailand Subdistricts data",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "number",
        "description": "The index of the subdistrict"
      },
      "province_id": {
        "type": "number",
        "description": "The province id"
      },
      "district_id": {
        "type": "number",
        "description": "The district id"
      },
      "subdistrict_id": {
        "type": "number",
        "description": "The subdistrict id"
      },
      "subdistrict_name_en": {
        "type": "string",
        "description": "The subdistrict name in english"
      },
      "subdistrict_name_th": {
        "type": "string",
        "description": "The subdistrict name in thai"
      },
      "postal_code": {
        "type": "number",
        "description": "The postal code"
      }
    },
    "required": [
      "id",
      "province_id",
      "district_id",
      "subdistrict_id",
      "subdistrict_name_en",
      "subdistrict_name_th",
      "postal_code"
    ]
  }
}
