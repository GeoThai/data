{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generated schema for Root",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "number",
        "description": "The subdistrict id"
      },
      "district_id": {
        "type": "number",
        "description": "The district id"
      },
      "en": {
        "type": "string",
        "description": "The subdistrict name in english"
      },
      "th": {
        "type": "string",
        "description": "The subdistrict name in thai"
      },
      "postal_code": {
        "type": "number",
        "description": "The postal code"
      }
    },
    "required": ["id", "district_id", "en", "th", "postal_code"]
  }
}
