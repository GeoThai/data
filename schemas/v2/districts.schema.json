{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thailand Districts",
  "description": "Schema for Thailand Districts data",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "number",
        "description": "The district id"
      },
      "province_id": {
        "type": "number",
        "description": "The province id"
      },
      "en": {
        "type": "string",
        "description": "The district name in english"
      },
      "th": {
        "type": "string",
        "description": "The district name in thai"
      },
      "subdistricts": {
        "type": "array",
        "description": "The subdistrict ids",
        "items": {
          "type": "number",
          "description": "The subdistrict id"
        }
      }
    },
    "required": ["id", "province_id", "en", "th", "subdistricts"]
  }
}
