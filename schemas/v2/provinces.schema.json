{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thailand Provinces",
  "description": "Schema for Thailand Provinces data",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "number",
        "description": "The province id"
      },
      "en": {
        "type": "string",
        "description": "The province name in english"
      },
      "th": {
        "type": "string",
        "description": "The province name in thai"
      },
      "districts": {
        "type": "array",
        "description": "The district ids",
        "items": {
          "type": "number",
          "description": "The district id"
        }
      }
    },
    "required": ["id", "en", "th", "districts"]
  }
}
